------------------------------------------------------------------------------
--                                                                          --
--                           TESTS FOR THE PARSER                           --
--                                                                          --
------------------------------------------------------------------------------

(with) "lib/test.shk"

(=> <>type) [
  length? 1 = not [abort] !?
  uncons >< << type? >< <<
]

------------------------------------------------------------------------------

                                  (test/run)
                                      [

--+-------------------------------------+-----------------------+-------------
--| Computation                         | Expectation           |-------------

  [ "1"       $parse                      [1]                   ] assert_equal
  [ "1"       $parse  <>type              :Number               ] assert_equal
  [ "12"      $parse                      [12]                  ] assert_equal
  [ "12"      $parse  <>type              :Number               ] assert_equal
  [ "-1"      $parse                      [-1]                  ] assert_equal
  [ "-1"      $parse  <>type              :Number               ] assert_equal
  [ "1_"      $parse                                            ] assert_error

  [ "0.1"     $parse                      [0.1]                 ] assert_equal
  [ "0.1"     $parse  <>type              :Number               ] assert_equal
  [ ".1"      $parse                      [.1]                  ] assert_equal
  [ "0."      $parse                      [0]                   ] assert_equal
  [ "-.0"     $parse                      [-.0]                 ] assert_equal

  [ "'a"      $parse                      ['a]                  ] assert_equal
  [ "'a"      $parse  <>type              :Character            ] assert_equal
  [ "'ab"     $parse                      ['a b]                ] assert_equal

  [ "\"a\""   $parse                      [['a]]                ] assert_equal
  [ "\"a\""   $parse  <>type              :List                 ] assert_equal
--+---------------------------------+---------------------------+-------------

                                      ]

(test/run) [
  [ "'\\033" $parse ['\033] ] assert_equal
  [ "'\\33" $parse ['\033] ] assert_equal
  [ "'\\7" $parse ['\007] ] assert_equal
  [ "'\\000" $parse ['\000] ] assert_equal
  [ "'\\377" $parse ['\377] ] assert_equal
  [ "'\\0334" $parse ['\033 4] ] assert_equal
  [ "\"\\0334\"" $parse [[ '\033 '4 ]] ] assert_equal
  [ "\"\\378\"" $parse [[ '\037 '8 ]] ] assert_equal
  [ "\"\\0x\"" $parse [[ '\000 'x ]] ] assert_equal
  [ "'\\400" $parse ] assert_error
  [ "\"\\777\"" $parse ] assert_error
  [ "'\\8" $parse ] assert_error
  [ "'\\" $parse ] assert_error
  [ "\"\\03" $parse ] assert_error
]
