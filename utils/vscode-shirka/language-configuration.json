{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "autoCloseBefore": "])\" \t\n",
  "wordPattern": ":?(?!--)[A-Za-z_~!@#$%^&*+\\-=|\\\\;,<>?/](?:(?!--)[A-Za-z0-9_~!@#$%^&*+\\-=|\\\\;,<>?/'])*|-?[0-9]+(?:\\.[0-9]*)?",
  "indentationRules": {
    "increaseIndentPattern": "^(?:(?:\"(?:[^\"\\\\]|\\\\.)*\"|'(?:\\\\.|[^\\\\])|(?!--)[^\\[\\]()\"']))*[\\[(](?:\"(?:[^\"\\\\]|\\\\.)*\"|'(?:\\\\.|[^\\\\])|(?!--)[^\\[\\]()\"'])*(?:--.*)?$",
    "decreaseIndentPattern": "^\\s*[\\])]"
  },
  "onEnterRules": [
    {
      "beforeText": "^(?:(?:\"(?:[^\"\\\\]|\\\\.)*\"|'(?:\\\\.|[^\\\\])|(?!--)[^\\[\\]()\"']))*[\\[(](?:\"(?:[^\"\\\\]|\\\\.)*\"|'(?:\\\\.|[^\\\\])|(?!--)[^\\[\\]()\"'])*(?:--.*)?$",
      "afterText": "^\\s*[\\])]",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^\\s*\\(=>\\s+\\.?(?!--)[A-Za-z_~!@#$%^&*+\\-=|\\\\;,<>?/](?:(?!--)[A-Za-z0-9_~!@#$%^&*+\\-=|\\\\;,<>?/'])*(?:\\.(?!--)[A-Za-z_~!@#$%^&*+\\-=|\\\\;,<>?/](?:(?!--)[A-Za-z0-9_~!@#$%^&*+\\-=|\\\\;,<>?/'])*)*\\)\\s*(?:--.*)?$",
      "action": {
        "indent": "indent"
      }
    }
  ],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*--\\s*#region\\b",
      "end": "^\\s*--\\s*#endregion\\b"
    }
  }
}
